<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SCCompanion.Models"
             x:Class="SCCompanion.Views.TradePage"
             Title="Trading"
             BackgroundColor="#0D0D0D"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="HeroTitleStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaxLines" Value="2" />
        </Style>

        <Style x:Key="ProviderLinkStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#007ACC" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <Style x:Key="SearchSurfaceStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#242424" />
            <Setter Property="Stroke" Value="#3A3A3A" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16,5,5,5" />
            <Setter Property="MinimumHeightRequest" Value="58" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="Padding" Value="8,10" />
        </Style>

        <Style x:Key="TradeCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#242424" />
            <Setter Property="Stroke" Value="#333333" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinimumHeightRequest" Value="66" />
        </Style>

        <Style x:Key="OverlayCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1E1E22" />
            <Setter Property="Stroke" Value="#3A3A3A" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="MaximumWidthRequest" Value="460" />
            <Setter Property="MaximumHeightRequest" Value="650" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid x:Name="MainContentGrid"
              RowDefinitions="Auto,Auto,Auto,Auto,*"
              Padding="18,4,18,16"
              RowSpacing="0"
              MaximumWidthRequest="820"
              HorizontalOptions="Fill">

            <VerticalStackLayout Grid.Row="0"
                                 Spacing="7"
                                 Margin="0,4,0,0">
                <Image Source="link_uex.png"
                       WidthRequest="136"
                       HeightRequest="52"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="UEX logo" />

                <Label Text="Trading"
                       Style="{StaticResource HeroTitleStyle}"
                       SemanticProperties.HeadingLevel="Level1" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="Data provided by"
                           FontSize="12"
                           TextColor="#A0A0A0"
                           VerticalTextAlignment="Center" />
                    <Label Text="uexcorp.space API"
                           Style="{StaticResource ProviderLinkStyle}"
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProviderTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="8"
                                 Margin="0,12,0,0">
                <Border x:Name="CommoditySearchHost"
                        Style="{StaticResource SearchSurfaceStyle}">
                    <Grid ColumnDefinitions="*,44">
                        <Entry x:Name="CommodityEntry"
                               Grid.Column="0"
                               Placeholder="Select Commodity"
                               PlaceholderColor="#777777"
                               TextColor="#FFFFFF"
                               BackgroundColor="Transparent"
                               FontSize="16"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Done"
                               MinimumHeightRequest="48"
                               TextChanged="OnCommodityTextChanged"
                               Focused="OnCommodityFocused"
                               HandlerChanged="OnSearchEntryHandlerChanged" />
                        <Button x:Name="CommodityDropDownButton"
                                Grid.Column="1"
                                Text="▼"
                                TextColor="#A0A0A0"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Padding="0"
                                Clicked="OnCommodityDropDownClicked"
                                SemanticProperties.Description="Show commodity choices" />
                    </Grid>
                </Border>

                <Border x:Name="TerminalSearchHost"
                        Style="{StaticResource SearchSurfaceStyle}">
                    <Grid ColumnDefinitions="*,44">
                        <Entry x:Name="TerminalEntry"
                               Grid.Column="0"
                               Placeholder="Select Shop/Terminal Location"
                               PlaceholderColor="#777777"
                               TextColor="#FFFFFF"
                               BackgroundColor="Transparent"
                               FontSize="16"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Done"
                               MinimumHeightRequest="48"
                               TextChanged="OnTerminalTextChanged"
                               Focused="OnTerminalFocused"
                               HandlerChanged="OnSearchEntryHandlerChanged" />
                        <Button x:Name="TerminalDropDownButton"
                                Grid.Column="1"
                                Text="▼"
                                TextColor="#A0A0A0"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Padding="0"
                                Clicked="OnTerminalDropDownClicked"
                                SemanticProperties.Description="Show terminal choices" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="8"
                  Margin="0,10,0,8">
                <Button Grid.Column="0"
                        Text="Buy"
                        Style="{StaticResource ActionButtonStyle}"
                        BackgroundColor="#404040"
                        BorderColor="#555555"
                        BorderWidth="1"
                        Clicked="OnBuyClicked" />
                <Button Grid.Column="1"
                        Text="Sell"
                        Style="{StaticResource ActionButtonStyle}"
                        BackgroundColor="#404040"
                        BorderColor="#555555"
                        BorderWidth="1"
                        Clicked="OnSellClicked" />
                <Button Grid.Column="2"
                        Text="Clear"
                        Style="{StaticResource ActionButtonStyle}"
                        BackgroundColor="#7A3434"
                        BorderColor="#934A4A"
                        BorderWidth="1"
                        Clicked="OnClearClicked" />
            </Grid>

            <Grid Grid.Row="3"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="8"
                  HorizontalOptions="Center"
                  Margin="0,0,0,8">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   Grid.Column="0"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Color="#FFFFFF"
                                   WidthRequest="18"
                                   HeightRequest="18" />
                <Label x:Name="StatusLabel"
                       Grid.Column="1"
                       Text="Loading price data from UEX..."
                       TextColor="#A0A0A0"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Grid>

            <CollectionView x:Name="TradeCardsView"
                            Grid.Row="4"
                            ItemsSource="{Binding TradeCards}"
                            SelectionMode="Single"
                            SelectionChanged="OnTradeCardSelected">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TradeCardViewItem">
                        <Border Style="{StaticResource TradeCardStyle}">
                            <Grid>
                                <Grid IsVisible="{Binding IsResult}"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Commodity}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="#FFFFFF"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding ResultLocation}"
                                               FontSize="13"
                                               TextColor="#A0A0A0"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding ResultPriceText}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="#FFFFFF"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding ResultActionText}"
                                               FontSize="12"
                                               TextColor="#A0A0A0"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid IsVisible="{Binding IsHotTrade}"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="6"
                                      ColumnSpacing="10">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Commodity}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           TextColor="#FFFFFF"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding ProfitText}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="#4FAE58"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding BuyLocationText}"
                                           FontSize="13"
                                           TextColor="#D0D0D0"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding BuyPriceText}"
                                           FontSize="13"
                                           TextColor="#A0A0A0"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{Binding SellLocationText}"
                                           FontSize="13"
                                           TextColor="#D0D0D0"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding SellPriceText}"
                                           FontSize="13"
                                           TextColor="#A0A0A0"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid x:Name="AutocompleteLayer"
              IsVisible="False">
            <Border x:Name="AutocompleteDropDownBorder"
                    BackgroundColor="#242424"
                    Stroke="#3A3A3A"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="4"
                    Margin="18,248,18,0"
                    MaximumWidthRequest="820"
                    HeightRequest="220"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start">
                <Grid RowDefinitions="Auto,*">
                    <Label x:Name="AutocompleteStatusLabel"
                           Grid.Row="0"
                           IsVisible="False"
                           FontSize="13"
                           TextColor="#A0A0A0"
                           Padding="12,10"
                           HorizontalTextAlignment="Center" />
                    <CollectionView x:Name="AutocompleteCollectionView"
                                    Grid.Row="1"
                                    ItemsSource="{Binding AutocompleteItems}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnAutocompleteItemSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#242424"
                                        Stroke="#333333"
                                        StrokeThickness="0"
                                        Padding="14,11">
                                    <Label Text="{Binding .}"
                                           FontSize="15"
                                           TextColor="#FFFFFF"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="InventoryOverlay"
              IsVisible="False"
              BackgroundColor="#B3000000">
            <Border Style="{StaticResource OverlayCardStyle}"
                    Margin="22"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <VerticalStackLayout Grid.Row="0" Spacing="4">
                        <Label x:Name="InventoryTitleLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="#FFFFFF"
                               HorizontalTextAlignment="Center"
                               MaxLines="2"
                               LineBreakMode="WordWrap" />
                        <Label Text="UEX crowdsourced quantity data"
                               FontSize="12"
                               TextColor="#A0A0A0"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding InventorySections}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TradeInventorySectionViewItem">
                                <Border BackgroundColor="#242424"
                                        Stroke="#333333"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14,12">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Heading}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               TextColor="#FFFFFF"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding Location}"
                                               FontSize="14"
                                               TextColor="#D0D0D0"
                                               HorizontalTextAlignment="Center"
                                               MaxLines="2"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding PriceText}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               TextColor="#FFFFFF"
                                               HorizontalTextAlignment="Center" />
                                        <Grid RowDefinitions="Auto,Auto"
                                              ColumnDefinitions="*,Auto"
                                              RowSpacing="5"
                                              ColumnSpacing="12">
                                            <Label Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding LastQuantityLabel}"
                                                   FontSize="13"
                                                   TextColor="#A0A0A0" />
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding LastQuantityText}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13"
                                                   TextColor="#FFFFFF"
                                                   HorizontalTextAlignment="End" />
                                            <Label Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding AverageQuantityLabel}"
                                                   FontSize="13"
                                                   TextColor="#A0A0A0" />
                                            <Label Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding AverageQuantityText}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13"
                                                   TextColor="#FFFFFF"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>
                                        <Label Text="{Binding LastUpdatedText}"
                                               FontSize="11"
                                               TextColor="#888888"
                                               HorizontalTextAlignment="Center" />
                                        <Label IsVisible="{Binding HasStatusWarning}"
                                               Text="{Binding StatusWarningText}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               TextColor="#D9A25F"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Grid.Row="2"
                            Text="Close"
                            Style="{StaticResource ActionButtonStyle}"
                            BackgroundColor="#404040"
                            BorderColor="#555555"
                            BorderWidth="1"
                            Clicked="OnCloseInventoryClicked" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
