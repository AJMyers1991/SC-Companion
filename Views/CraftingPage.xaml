<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SCCompanion.Controls"
             x:Class="SCCompanion.Views.CraftingPage"
             Title="Crafting"
             BackgroundColor="#0D0D0D"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="HeroTitleStyle"
               TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MaxLines" Value="2" />
        </Style>

        <Style x:Key="SearchSurfaceStyle"
               TargetType="Border">
            <Setter Property="BackgroundColor" Value="#242424" />
            <Setter Property="Stroke" Value="#3A3A3A" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16,5" />
        </Style>

        <Style x:Key="ResultCardStyle"
               TargetType="Border">
            <Setter Property="BackgroundColor" Value="#242424" />
            <Setter Property="Stroke" Value="#333333" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="MinimumHeightRequest" Value="58" />
        </Style>

        <Style x:Key="SectionLabelStyle"
               TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="0.8" />
            <Setter Property="TextColor" Value="#A0A0A0" />
        </Style>

        <Style x:Key="ProviderLinkStyle"
               TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#007ACC" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <Style x:Key="FavoriteButtonStyle"
               TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Main content -->
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="0"
              Padding="18,4,18,16">
            <VerticalStackLayout Grid.Row="0"
                                 MaximumWidthRequest="820"
                                 HorizontalOptions="Fill"
                                 Spacing="7"
                                 Margin="0,4,0,0">
                <Image Source="link_sccraft.png"
                       WidthRequest="136"
                       HeightRequest="136"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="SC-Craft logo" />

                <Label Text="Crafting &amp; Blueprints"
                       Style="{StaticResource HeroTitleStyle}"
                       SemanticProperties.HeadingLevel="Level1" />

                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="4">
                    <Label Text="Data provided by"
                           FontSize="12"
                           TextColor="#A0A0A0"
                           VerticalTextAlignment="Center" />
                    <Label x:Name="ProviderLinkLabel"
                           Text="sc-craft.tools"
                           Style="{StaticResource ProviderLinkStyle}"
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProviderTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    Style="{StaticResource SearchSurfaceStyle}"
                    MaximumWidthRequest="820"
                    HorizontalOptions="Fill"
                    Margin="0,12,0,12">
                <Entry x:Name="SearchEntry"
                       Placeholder="Search blueprints..."
                       PlaceholderColor="#777777"
                       TextColor="#FFFFFF"
                       BackgroundColor="Transparent"
                       FontSize="16"
                       ClearButtonVisibility="WhileEditing"
                       ReturnType="Search"
                       MinimumHeightRequest="48"
                       TextChanged="OnSearchTextChanged"
                       HandlerChanged="OnSearchEntryHandlerChanged"
                       SemanticProperties.Description="Search for crafting blueprints" />
            </Border>

            <Grid Grid.Row="2"
                  RowDefinitions="Auto,*"
                  MaximumWidthRequest="820"
                  HorizontalOptions="Fill"
                  RowSpacing="6">
                <HorizontalStackLayout Grid.Row="0"
                                       HorizontalOptions="Center"
                                       Spacing="8"
                                       Margin="0,0,0,4">
                    <ActivityIndicator x:Name="SearchActivityIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#FFFFFF"
                                       WidthRequest="18"
                                       HeightRequest="18" />
                    <Label x:Name="StatusLabel"
                           IsVisible="False"
                           TextColor="#A0A0A0"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </HorizontalStackLayout>

                <Grid Grid.Row="1">
                    <!-- Saved items share one scrolling surface so five recent
                         items do not constrain the available Favorites area. -->
                    <ScrollView x:Name="SavedItemsScrollView"
                                IsVisible="False">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout x:Name="RecentSection"
                                                 IsVisible="False"
                                                 Spacing="8">
                                <Label Text="RECENTLY OPENED"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="4,0" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentItems}"
                                                     Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ResultCardStyle}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                                                          Tapped="OnSavedItemTapped" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="12">
                                                    <VerticalStackLayout Grid.Column="0"
                                                                         Spacing="2"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding Name}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="16"
                                                               TextColor="#FFFFFF"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"
                                                               HorizontalTextAlignment="Center" />
                                                        <Label Text="{Binding Classification}"
                                                               FontFamily="OpenSansRegular"
                                                               FontSize="13"
                                                               TextColor="#A0A0A0"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"
                                                               HorizontalTextAlignment="Center" />
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1"
                                                            Text="{Binding FavoriteGlyph}"
                                                            TextColor="{Binding FavoriteColor}"
                                                            Style="{StaticResource FavoriteButtonStyle}"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start"
                                                            CommandParameter="{Binding .}"
                                                            Clicked="OnFavoriteClicked" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="FavoritesSection"
                                                 IsVisible="False"
                                                 Spacing="8">
                                <Label Text="FAVORITES"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Margin="4,0" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FavoriteItems}"
                                                     Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ResultCardStyle}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                                                          Tapped="OnSavedItemTapped" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="12">
                                                    <VerticalStackLayout Grid.Column="0"
                                                                         Spacing="2"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding Name}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="16"
                                                               TextColor="#FFFFFF"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"
                                                               HorizontalTextAlignment="Center" />
                                                        <Label Text="{Binding Classification}"
                                                               FontFamily="OpenSansRegular"
                                                               FontSize="13"
                                                               TextColor="#A0A0A0"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"
                                                               HorizontalTextAlignment="Center" />
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1"
                                                            Text="{Binding FavoriteGlyph}"
                                                            TextColor="{Binding FavoriteColor}"
                                                            Style="{StaticResource FavoriteButtonStyle}"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start"
                                                            CommandParameter="{Binding .}"
                                                            Clicked="OnFavoriteClicked" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Search Results -->
                    <CollectionView x:Name="ResultsCollectionView"
                                    IsVisible="False"
                                    ItemsSource="{Binding Results}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnResultSelected">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                               ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ResultCardStyle}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   TextColor="#FFFFFF"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Classification}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="13"
                                                   TextColor="#A0A0A0"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="{Binding FavoriteGlyph}"
                                                TextColor="{Binding FavoriteColor}"
                                                Style="{StaticResource FavoriteButtonStyle}"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnFavoriteClicked" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Navigation Loading Overlay -->
        <controls:RocketLoadingIndicator x:Name="NavigationLoader"
                                        IsRunning="False"
                                        Message="Loading blueprint details..."
                                        BackgroundColor="#80000000"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
    </Grid>
</ContentPage>