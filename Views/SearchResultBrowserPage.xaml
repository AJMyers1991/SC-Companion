<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SCCompanion.Views.SearchResultBrowserPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0D0D0D">

    <Grid RowDefinitions="Auto,*">
        <Border x:Name="PortraitToolbar"
                Grid.Row="0"
                BackgroundColor="#1E1E22"
                StrokeThickness="0"
                Padding="8,6">
            <Grid ColumnDefinitions="48,*"
                  ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="24"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        Padding="0"
                        Clicked="OnBackClicked"
                        SemanticProperties.Description="Back" />
                <Label x:Name="PageTitleLabel"
                       Grid.Column="1"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="#FFFFFF"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,48,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <WebView x:Name="BrowserWebView"
                     Navigating="OnWebViewNavigating"
                     Navigated="OnWebViewNavigated"
                     HandlerChanged="OnWebViewHandlerChanged" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               Color="#FFFFFF"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   Text="The page could not be loaded."
                   FontFamily="OpenSansRegular"
                   FontSize="14"
                   TextColor="#FFFFFF"
                   BackgroundColor="#CC0D0D0D"
                   Padding="18,12"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
