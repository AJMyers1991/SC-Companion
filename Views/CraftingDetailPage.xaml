<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SCCompanion.Controls"
             x:Class="SCCompanion.Views.CraftingDetailPage"
             BackgroundColor="#0D0D0D"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="DetailCardStyle"
               TargetType="Border">
            <Setter Property="BackgroundColor" Value="#242424" />
            <Setter Property="Stroke" Value="#333333" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,8" />
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DetailLabelStyle"
               TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#A0A0A0" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="IngredientCardStyle"
               TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1A1A1A" />
            <Setter Property="Stroke" Value="#333333" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="QualitySliderStyle"
               TargetType="Slider">
            <Setter Property="MinimumTrackColor" Value="#007ACC" />
            <Setter Property="MaximumTrackColor" Value="#333333" />
            <Setter Property="ThumbColor" Value="#FFFFFF" />
        </Style>

        <Style x:Key="QualityEntryStyle"
               TargetType="Entry">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="BackgroundColor" Value="#333333" />
            <Setter Property="WidthRequest" Value="80" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="Keyboard" Value="Numeric" />
        </Style>

        <Style x:Key="StatRowStyle"
               TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1A1A1A" />
            <Setter Property="Stroke" Value="#333333" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style x:Key="MissionCardStyle"
               TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1A1A1A" />
            <Setter Property="Stroke" Value="#333333" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollView Padding="18,16">
            <VerticalStackLayout Spacing="0"
                                 MaximumWidthRequest="820"
                                 HorizontalOptions="Fill">

                <!-- Blueprint Info Card -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="44,*,44">
                            <Label Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="#FFFFFF"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Start"
                                   LineBreakMode="WordWrap"
                                   MaxLines="3" />

                            <Button Grid.Column="2"
                                    Text="{Binding FavoriteGlyph}"
                                    TextColor="{Binding FavoriteColor}"
                                    BackgroundColor="Transparent"
                                    FontSize="22"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0"
                                    Margin="0,-10,-12,0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Clicked="OnFavoriteClicked" />
                        </Grid>

                        <VerticalStackLayout Grid.Row="1"
                                             Spacing="16"
                                             Margin="0,16,0,0">

                            <Grid VerticalOptions="Start">
                                <!-- Blueprint Image -->
                                <Image Source="{Binding ImageSource}"
                                       WidthRequest="280"
                                       HeightRequest="220"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center" />
                                <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                   IsVisible="{Binding IsImageLoading}"
                                                   Color="#FFFFFF"
                                                   WidthRequest="24"
                                                   HeightRequest="24"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                            </Grid>

                            <!-- Category -->
                            <Label Text="{Binding CategoryText}"
                                   Style="{StaticResource DetailLabelStyle}"
                                   HorizontalTextAlignment="Center" />

                            <!-- Craft Time -->
                            <Label Text="{Binding CraftTimeText}"
                                   Style="{StaticResource DetailLabelStyle}"
                                   HorizontalTextAlignment="Center" />

                            <!-- Tiers -->
                            <Label Text="{Binding TiersText}"
                                   Style="{StaticResource DetailLabelStyle}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Required Materials Card -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Required Materials"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalTextAlignment="Center" />
                        
                        <!-- Global Quality Control -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Global Quality"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#FFFFFF"
                                   HorizontalTextAlignment="Center" />
                            
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   Spacing="12">
                                <Slider x:Name="GlobalQualitySlider"
                                        Value="{Binding GlobalQuality}"
                                        Minimum="0"
                                        Maximum="1000"
                                        WidthRequest="200"
                                        Style="{StaticResource QualitySliderStyle}"
                                        ValueChanged="OnGlobalQualityChanged" />
                                
                                <Entry x:Name="GlobalQualityEntry"
                                       Text="{Binding GlobalQualityText}"
                                       Style="{StaticResource QualityEntryStyle}"
                                       Completed="OnGlobalQualityCompleted"
                                       Unfocused="OnGlobalQualityUnfocused" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        
                        <!-- Ingredient List -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IngredientCardStyle}">
                                        <VerticalStackLayout Spacing="12">
                                            <!-- Material Name and Quantity -->
                                            <VerticalStackLayout Spacing="4"
                                                                 HorizontalOptions="Center">
                                                <Label Text="{Binding SlotName}"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="12"
                                                       TextColor="#888888"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Name}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="#FFFFFF"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="2"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding QuantityText}"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="12"
                                                       TextColor="#A0A0A0"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>

                                            <!-- Quality Control -->
                                            <HorizontalStackLayout HorizontalOptions="Center"
                                                                   Spacing="12">
                                                <Slider Value="{Binding Quality}"
                                                        Minimum="0"
                                                        Maximum="1000"
                                                        WidthRequest="160"
                                                        Style="{StaticResource QualitySliderStyle}"
                                                        ValueChanged="OnIngredientQualityChanged" />
                                                
                                                <Entry Text="{Binding QualityText}"
                                                       Style="{StaticResource QualityEntryStyle}"
                                                       Completed="OnIngredientQualityCompleted"
                                                       Unfocused="OnIngredientQualityUnfocused" />
                                            </HorizontalStackLayout>

                                            <!-- Effect Rows -->
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding EffectRows}"
                                                                 Spacing="4"
                                                                 IsVisible="{Binding HasEffects}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Label Text="{Binding Text}"
                                                               FontFamily="OpenSansRegular"
                                                               FontSize="12"
                                                               TextColor="{Binding TextColor}"
                                                               HorizontalTextAlignment="Center"
                                                               LineBreakMode="WordWrap" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Stat Summary Card -->
                <Border Style="{StaticResource DetailCardStyle}"
                        IsVisible="{Binding HasStatRows}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Stat Summary"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalTextAlignment="Center" />
                        
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding StatRows}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatRowStyle}">
                                        <Grid ColumnDefinitions="1.5*,0.7*,*" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="{Binding Stat}" FontFamily="OpenSansRegular" FontSize="13" TextColor="#FFFFFF" />
                                            <Label Grid.Column="1" Text="{Binding BaseValue}" FontFamily="OpenSansRegular" FontSize="13" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="2" Text="{Binding CraftedValue}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{Binding CraftedColor}" HorizontalTextAlignment="End" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Blueprint Missions Card -->
                <Border Style="{StaticResource DetailCardStyle}"
                        IsVisible="{Binding HasMissions}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Blueprint Missions"
                               Style="{StaticResource SectionTitleStyle}"
                               HorizontalTextAlignment="Center" />
                        
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Missions}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MissionCardStyle}"
                                            Padding="14,10"
                                            Margin="0,3">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               TextColor="#FFFFFF"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Detail Loading Overlay -->
        <controls:RocketLoadingIndicator x:Name="DetailLoader"
                                        IsRunning="False"
                                        Message="Loading blueprint details..."
                                        BackgroundColor="#80000000"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
    </Grid>
</ContentPage>