<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SCCompanion.Models"
             x:Class="SCCompanion.Views.ShipsPage"
             Title="Ships"
             BackgroundColor="#0D0D0D"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="ShipButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/><Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinimumHeightRequest" Value="44"/><Setter Property="BorderWidth" Value="1"/>
        </Style>
        <Style x:Key="ShipCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#242424"/><Setter Property="Stroke" Value="#333333"/>
            <Setter Property="StrokeThickness" Value="1"/><Setter Property="StrokeShape" Value="RoundRectangle 14"/>
            <Setter Property="Padding" Value="8"/><Setter Property="MinimumHeightRequest" Value="148"/>
        </Style>
        <Style x:Key="ModalCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#1E1E22"/><Setter Property="Stroke" Value="#3A3A3A"/>
            <Setter Property="StrokeThickness" Value="1"/><Setter Property="StrokeShape" Value="RoundRectangle 18"/>
            <Setter Property="MaximumWidthRequest" Value="540"/><Setter Property="MaximumHeightRequest" Value="760"/>
        </Style>
        <Style x:Key="FilterEntry" TargetType="Entry">
            <Setter Property="TextColor" Value="White"/><Setter Property="PlaceholderColor" Value="#777777"/>
            <Setter Property="BackgroundColor" Value="#242424"/><Setter Property="FontSize" Value="14"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid x:Name="MainContentGrid" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="12,8,12,12" RowSpacing="6" MaximumWidthRequest="900">
            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="Ships" FontFamily="OpenSansSemibold" FontSize="24" TextColor="White" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level1"/>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                    <Label Text="Data provided by " FontSize="12" TextColor="#A0A0A0"/>
                    <Label Text="FleetYards.net" FontSize="12" TextColor="#007ACC" TextDecorations="Underline">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnProviderTapped"/></Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Border Grid.Row="1" BackgroundColor="#242424" Stroke="#3A3A3A" StrokeShape="RoundRectangle 18" Padding="14,3" MinimumHeightRequest="54">
                <Entry x:Name="SearchEntry" Placeholder="Search ships by name..." PlaceholderColor="#777777" TextColor="White" BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing" TextChanged="OnSearchTextChanged" HandlerChanged="OnSearchEntryHandlerChanged"/>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="6">
                <Button Grid.Row="0" Grid.Column="0" Text="Filter" Style="{StaticResource ShipButton}" BackgroundColor="#404040" BorderColor="#555555" Clicked="OnFilterClicked"/>
                <Button Grid.Row="0" Grid.Column="1" Text="Clear Filter" Style="{StaticResource ShipButton}" BackgroundColor="#7A3434" BorderColor="#934A4A" Clicked="OnClearFilterClicked"/>
                <Button Grid.Row="1" Grid.ColumnSpan="2" Text="Show My Fleet" Style="{StaticResource ShipButton}" BackgroundColor="#3F6B46" BorderColor="#557F5C" Clicked="OnShowFleetClicked"/>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalOptions="Center">
                <ActivityIndicator x:Name="LoadingIndicator" Color="White" WidthRequest="18" HeightRequest="18"/>
                <Label x:Name="StatusLabel" Grid.Column="1" FontSize="12" TextColor="#A0A0A0" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
            </Grid>

            <CollectionView x:Name="ShipsView" Grid.Row="4" ItemsSource="{Binding Ships}" SelectionMode="Single" SelectionChanged="OnShipSelected">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/></CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ShipCardViewItem">
                        <Border Style="{StaticResource ShipCard}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="{Binding ImageUrl}" Aspect="AspectFit" HeightRequest="108" VerticalOptions="Center"/>
                                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Padding="0,0,2,0">
                                    <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Spacing="4">
                                        <Label Text="Favorite" FontSize="11" TextColor="#A0A0A0" VerticalTextAlignment="Center"/>
                                        <Button Text="{Binding FavoriteGlyph}" TextColor="{Binding FavoriteColor}" FontSize="22" BackgroundColor="Transparent" BorderWidth="0" Padding="2" WidthRequest="34" HeightRequest="34" Clicked="OnFavoriteClicked"/>
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Spacing="4" HorizontalOptions="Fill" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="White" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Manufacturer}" FontSize="12" TextColor="#A0A0A0" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding ClassificationAndRole}" FontSize="12" TextColor="#A0A0A0" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding CargoAndCrew}" FontSize="12" TextColor="#D0D0D0" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding PriceLine}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#007ACC" HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="4">
                                        <Label Text="My Fleet" FontSize="11" TextColor="#A0A0A0" VerticalTextAlignment="Center"/>
                                        <Button Text="{Binding FleetGlyph}" TextColor="{Binding FleetColor}" FontSize="20" BackgroundColor="Transparent" BorderWidth="0" Padding="2" WidthRequest="34" HeightRequest="34" Clicked="OnFleetClicked"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid x:Name="FilterOverlay" IsVisible="False" BackgroundColor="#B3000000" Padding="14">
            <Border Style="{StaticResource ModalCard}" HorizontalOptions="Center" VerticalOptions="Center" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Label Text="Filters" Padding="20,16" FontFamily="OpenSansSemibold" FontSize="22" TextColor="White"/>
                    <ScrollView Grid.Row="1"><VerticalStackLayout Padding="20,12" Spacing="14">
                        <HorizontalStackLayout><CheckBox x:Name="FavoritesOnlyCheck"/><Label Text="Show Favorites Only" TextColor="White" VerticalTextAlignment="Center"/></HorizontalStackLayout>
                        <Label Text="Manufacturer" FontFamily="OpenSansSemibold" TextColor="White"/>
                        <Button x:Name="ManufacturerSelectionButton" Text="All" Style="{StaticResource ShipButton}" BackgroundColor="#242424" BorderColor="#555555" Clicked="OnManufacturerSelectionClicked"/>
                        <Label Text="Type / Classification" FontFamily="OpenSansSemibold" TextColor="White"/>
                        <HorizontalStackLayout><CheckBox x:Name="ShipCheck"/><Label Text="Ship" TextColor="White" VerticalTextAlignment="Center"/></HorizontalStackLayout>
                        <HorizontalStackLayout><CheckBox x:Name="GroundCheck"/><Label Text="Ground Vehicle" TextColor="White" VerticalTextAlignment="Center"/></HorizontalStackLayout>
                        <Label Text="Role / Focus" FontFamily="OpenSansSemibold" TextColor="White"/>
                        <Button x:Name="RoleSelectionButton" Text="All" Style="{StaticResource ShipButton}" BackgroundColor="#242424" BorderColor="#555555" Clicked="OnRoleSelectionClicked"/>
                        <Label Text="Status / Production" FontFamily="OpenSansSemibold" TextColor="White"/>
                        <HorizontalStackLayout><CheckBox x:Name="FlightReadyCheck"/><Label Text="Flight Ready" TextColor="White" VerticalTextAlignment="Center"/></HorizontalStackLayout>
                        <HorizontalStackLayout><CheckBox x:Name="ConceptCheck"/><Label Text="In Concept" TextColor="White" VerticalTextAlignment="Center"/></HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="MinScuEntry" Placeholder="Min SCU" Keyboard="Numeric" Style="{StaticResource FilterEntry}" HandlerChanged="OnIosSearchInputHandlerChanged"/>
                            <Entry x:Name="MaxScuEntry" Grid.Column="1" Placeholder="Max SCU" Keyboard="Numeric" Style="{StaticResource FilterEntry}" HandlerChanged="OnIosSearchInputHandlerChanged"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="MinPriceEntry" Placeholder="Min Price" Keyboard="Numeric" Style="{StaticResource FilterEntry}" HandlerChanged="OnIosSearchInputHandlerChanged"/>
                            <Entry x:Name="MaxPriceEntry" Grid.Column="1" Placeholder="Max Price" Keyboard="Numeric" Style="{StaticResource FilterEntry}" HandlerChanged="OnIosSearchInputHandlerChanged"/>
                        </Grid>
                        <HorizontalStackLayout><CheckBox x:Name="AuecPriceCheck"/><Label Text="Price is in aUEC (vs USD pledge)" FontSize="12" TextColor="White" VerticalTextAlignment="Center"/></HorizontalStackLayout>
                    </VerticalStackLayout></ScrollView>
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,12">
                        <Button Text="Cancel" Style="{StaticResource ShipButton}" BackgroundColor="#7A3434" BorderColor="#934A4A" Clicked="OnFilterCancelClicked"/>
                        <Button Grid.Column="1" Text="OK" Style="{StaticResource ShipButton}" BackgroundColor="#3F6B46" BorderColor="#557F5C" Clicked="OnFilterOkClicked"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SelectionOverlay" IsVisible="False" BackgroundColor="#D9000000" Padding="18">
            <Border Style="{StaticResource ModalCard}" HorizontalOptions="Center" VerticalOptions="Center" Padding="0">
                <Grid RowDefinitions="Auto,Auto,*,Auto" MinimumHeightRequest="480">
                    <Label x:Name="SelectionTitleLabel" Text="Select options" Padding="20,16" FontFamily="OpenSansSemibold" FontSize="20" TextColor="White" HorizontalTextAlignment="Center"/>
                    <Entry x:Name="SelectionSearchEntry" Grid.Row="1" Margin="16,0,16,10" Placeholder="Search or tap to browse..." Style="{StaticResource FilterEntry}" TextChanged="OnSelectionSearchChanged" HandlerChanged="OnIosSearchInputHandlerChanged"/>
                    <CollectionView x:Name="SelectionOptionsView" Grid.Row="2" ItemsSource="{Binding SelectionOptions}" SelectionMode="Single" SelectionChanged="OnSelectionOptionSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ShipFilterOptionViewItem">
                                <Grid ColumnDefinitions="44,*" Padding="14,8">
                                    <Label Text="{Binding CheckGlyph}" TextColor="{Binding CheckColor}" FontSize="20" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1" Text="{Binding Value}" TextColor="White" VerticalTextAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Grid.Row="3" Text="Done" Margin="16,10,16,14" Style="{StaticResource ShipButton}" BackgroundColor="#404040" BorderColor="#555555" Clicked="OnSelectionDoneClicked"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
