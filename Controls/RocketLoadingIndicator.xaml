<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SCCompanion.Controls.RocketLoadingIndicator"
             x:Name="RootControl">

    <ContentView.Resources>
        <Style x:Key="LoaderLabelStyle"
               TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#A0A0A0" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid x:Name="MainContainer"
          IsVisible="{Binding Source={x:Reference RootControl}, Path=IsRunning}"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        
        <!-- Keep the orbit itself at the exact viewport center. The message is
             overlaid below it so it does not shift the animation upward. -->
        <Grid HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Grid x:Name="RocketContainer"
                  WidthRequest="120"
                  HeightRequest="120"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                
                <!-- Orbit circle (subtle neutral guide) -->
                <Ellipse Stroke="#555555"
                         StrokeThickness="4"
                         Fill="Transparent"
                         WidthRequest="100"
                         HeightRequest="100"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Opacity="0.4" />
                
                <!-- Project rocket artwork -->
                <Image x:Name="RocketLabel"
                       Source="rocket_loader.png"
                       WidthRequest="30"
                       HeightRequest="27"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TranslationX="50"
                       TranslationY="0" />
            </Grid>

            <Label x:Name="LoadingMessage"
                   Text="{Binding Source={x:Reference RootControl}, Path=Message}"
                   Style="{StaticResource LoaderLabelStyle}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TranslationY="92" />
        </Grid>
    </Grid>
</ContentView>